# .env は自動ロードされません。環境変数として設定してください。
# 本番では十分に長くランダムな値を設定すること。
SECRET_KEY=replace-with-a-random-string-at-least-32-characters
APP_BASE_URL=http://127.0.0.1:8000
DATABASE_PATH=./data/parking.sqlite3
ENVIRONMENT=development
# メール認証・パスワード再設定。本番では設定必須。
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true
# 本番は https 化し、true を指定。
SESSION_SECURE=false
# 自動公開する AdSense 設定。サイト審査通過後に利用。
ADSENSE_PUBLISHER_ID=
# AdSense ads.txt 用 ID（Publisher IDと同じ）
ADSENSE_ACCOUNT_ID=
